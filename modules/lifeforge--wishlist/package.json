    "build:client": "cd client && vite build",
    "build:server": "cd server && vite build"
  },
  "dependencies": {
    "open-graph-scraper": "^6.11.0",
    "sharp": "^0.34.4"
  },
  "devDependencies": {},
  "displayName": "Wishlist",
