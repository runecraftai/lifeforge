# LifeForge Docker Compose – environment configuration
# Copy this file to env/.env.docker and fill in the values.
#
# All three variables are REQUIRED.

# PocketBase superuser credentials
PB_EMAIL=admin@example.com
PB_PASSWORD=changeme-at-least-8-chars

# PocketBase master key (min 16 chars) – used by the forge CLI
MASTER_KEY=changeme-master-key-min-16-chars

# ── Optional port overrides (used in docker-compose.yaml) ─────────────
# Uncomment and change to use different host ports:
# PB_PORT=18090       # PocketBase
# API_PORT=13636      # API server
# WEB_PORT=15173      # Web client (nginx)
